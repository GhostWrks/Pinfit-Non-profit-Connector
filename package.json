{
  "name": "nonprofitfinder-backend",
  "version": "0.1.0",
  "description": "Backend API for NonProfitFinder using ArcGIS-friendly services",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "check": "node --check src/server.js",
    "frontend:install": "npm --prefix frontend install",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build"
  },
  "keywords": [
    "nonprofit",
    "arcgis",
    "express",
    "community"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@esri/arcgis-rest-feature-service": "^4.1.1",
    "@esri/arcgis-rest-geocoding": "^4.1.1",
    "@esri/arcgis-rest-request": "^4.1.1",
    "@esri/arcgis-rest-routing": "^4.1.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
